generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("customer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviews         RestaurantReview[]
  savedRestaurants SavedRestaurant[]
  restaurants     Restaurant[] @relation("RestaurantOwner")
}

model Restaurant {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String
  address     String
  phoneNumber String
  openingHours String
  cuisine     String
  priceLevel  Int                @default(2)
  rating      Float              @default(0)
  reviewCount Int                @default(0)
  imageUrl    String
  city        String             @default("")
  latitude    Float?
  longitude   Float?
  isFeatured  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  ownerId     String?

  owner       User?              @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviews     RestaurantReview[]
  favorites   SavedRestaurant[]

  @@index([city])
  @@index([cuisine])
  @@index([rating])
}

model RestaurantReview {
  id           String     @id @default(cuid())
  rating       Int
  comment      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurantId String
  userId       String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
}

model SavedRestaurant {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  restaurantId String
  userId       String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
}
